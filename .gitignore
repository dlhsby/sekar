logs/

# Environment files. Plaintext dev files stay private; deploy files (.env.staging,
# .env.production) are committed as dotenvx-ENCRYPTED ciphertext (secrets are
# `encrypted:…`, safe in git). See specs/deployment/encrypted-secrets.md.
.env
.env.local
.env.development
# dotenvx private decryption keys — NEVER commit (this is the one real secret).
.env.keys
# Decrypted scratch files produced at build time — never commit.
.env.*.decrypted
.env.runtime
!.env*.example

# TLS certificates for the production Nginx (mounted into the container)
infra/certs/

# Infrastructure data (persistent volumes)
infra/data/
infra/localstack/

# Root-level npm workspaces (Phase 3 onward — see ADR-036)
/node_modules/

# Local scratch data (PII, raw exports) — never commit; removed 2026-07-05
/data/

# Per-session scratch prompts / planning notes — not part of the repo
prompts/

# Parallel dev worktrees (scripts/worktree.sh) — local checkouts, not shared state
.claude/worktrees/


# WSL/Windows alternate-data-stream junk (sit next to downloaded creds)
*:Zone.Identifier

# JVM crash dumps — Gradle/Metro can drop these in the repo root mid-build.
# One (hs_err_pid124689.log) reached main via a broad `git add -A`.
hs_err_pid*.log
replay_pid*.log

# Database dumps / clones — real staging data. NEVER commit these.
# The clone script keeps them outside the repo by default; this is the guard for
# the day someone points STAGING_CLONE_DIR inside it.
*.dump
*.dump.partial
*.sql.gz
staging-clone/

# Claude Code plugin/skill artifacts — per-developer tooling state, not project
# code. `.agents/` holds locally-installed skill definitions and
# `skills-lock.json` pins their hashes; both are regenerated per machine and
# would otherwise sit permanently in `git status` as untracked noise.
.agents/
skills-lock.json
