@@ -93,6 +93,16 @@ exports.ICNS = {
         while (imageOffset < fileLength && imageOffset < inputLength) {
             imageHeader = readImageHeader(input, imageOffset);
             imageSize = getImageSize(imageHeader[0]);
+            // GHSA-w3rx-r6r6-pgpr: an entry whose declared length is 0 (or is
+            // smaller than the 8-byte entry header it must include) leaves
+            // `imageOffset` unchanged, so this loop never terminates and the
